<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WetFlow</AssemblyName>
    <RootNamespace>WetFlow</RootNamespace>
    <ApplicationIcon>Resources\mic_idle.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\mic_idle.ico" />
    <EmbeddedResource Include="Resources\mic_recording.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WetFlow.Tests" />
  </ItemGroup>

</Project>
